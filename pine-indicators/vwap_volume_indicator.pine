// VWAP+Volume Indicator — Directional Bias
//
// Backtested Python equivalent (SPY 2021-2026, 5d hold):
//   FAR_BELOW VWAP (>1% below rolling VWAP): Sharpe 1.67, WR 56.9%,
//     +0.32%/signal, 225 signals  ← BUY
//   FAR_ABOVE VWAP: no edge on SPY → HOLD (asymmetric signal)
//   Weak volume: no confirmation → HOLD
//
// Uses a 20-period rolling VWAP (volume-weighted moving average).
// One-sided: only produces BUY signals when price is significantly
// below its volume-weighted average with normal or strong volume.
// This asymmetry is confirmed by backtesting — selling VWAP premiums
// has no edge on broad market ETFs.

//@version=6
indicator(title='VWAP+Volume Indicator', shorttitle='VWAP+Vol+', overlay=true)

// ===== Inputs =====
vwapLen       = input.int(20, title='Rolling VWAP Length')
devThresh     = input.float(1.0, title='Deviation Threshold (%)')
volAvgLen     = input.int(20, title='Volume Average Length')
volStrongMult = input.float(1.5, title='Strong Volume Multiplier')
volWeakMult   = input.float(0.7, title='Weak Volume Multiplier')

// ===== Rolling VWAP (volume-weighted moving average) =====
tp  = (high + low + close) / 3
cumPV  = ta.cum(tp * volume)
cumV   = ta.cum(volume)
vwapRoll = (cumPV - ta.cum(tp * volume)[vwapLen]) / (cumV - ta.cum(volume)[vwapLen])

// ===== Deviation =====
devPct = (close / vwapRoll - 1) * 100

// ===== Volume quality =====
avgVol    = ta.sma(volume, volAvgLen)
strongVol = volume > avgVol * volStrongMult
weakVol   = volume < avgVol * volWeakMult

// ===== Bias logic (one-sided: only buys VWAP dips) =====
farBelow  = devPct < -devThresh
buySignal = farBelow and not weakVol

// ===== Visual: VWAP line =====
plot(vwapRoll, title='Rolling VWAP', color=color.new(color.yellow, 0), linewidth=2)

// ===== Background highlight =====
bgcolor(buySignal ? color.new(color.green, 92) : na, title='Buy Signal BG')

// ===== Entry markers =====
plotshape(buySignal, title='BUY', location=location.belowbar, style=shape.triangleup, color=color.green, size=size.small)

// ===== Status label =====
var label vwapLabel = na
if barstate.islast
    label.delete(vwapLabel)
    zoneTxt = farBelow ? 'FAR BELOW VWAP (' + str.tostring(devPct, '#.#') + '%)' :
              devPct > devThresh ? 'ABOVE VWAP (' + str.tostring(devPct, '#.#') + '%) — no edge' :
              'NEAR VWAP (' + str.tostring(devPct, '#.#') + '%)'
    volTxt  = strongVol ? ' | STRONG VOL' : weakVol ? ' | WEAK VOL' : ' | NORMAL VOL'
    biasTxt = buySignal ? ' → BUY' : ' → HOLD'
    vwapLabel := label.new(bar_index, vwapRoll, zoneTxt + volTxt + biasTxt,
     style=label.style_label_up, color=color.new(color.yellow, 0), textcolor=color.black, size=size.small)

alertcondition(buySignal, title='VWAP BUY', message='{{ticker}} FAR_BELOW VWAP + volume confirmed → BUY')
