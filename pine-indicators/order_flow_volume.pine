// Order Flow Volume — Institutional Footprint
//
// Replaces the plain volume histogram with a split buy/sell view plus the
// three things that actually distinguish institutional participation from
// retail noise: delta, absorption, and delta/price divergence.
//
// ============================================================================
// WHAT THIS IS AND IS NOT — read before trusting it
// ============================================================================
//
// This is NOT true order flow. True order flow means knowing the AGGRESSOR
// side of every trade (did a market buy lift the ask, or a market sell hit the
// bid), plus depth of market and individual trade sizes. That requires
// tick-level bid/ask data. Pine Script has no access to bid/ask, no Level 2 /
// DOM, and no per-trade size, so genuine block-trade and sweep detection is
// impossible here at any level of effort.
//
// What this DOES is intrabar approximation — the same method TradingView's own
// built-in Volume Delta and CVD indicators use, because it is the best
// available: pull every lower-timeframe bar inside the current chart bar via
// request.security_lower_tf(), then classify each intrabar's volume as buying
// or selling by its own direction:
//     close > open            -> buying volume
//     close < open            -> selling volume
//     close == open           -> compare to the previous intrabar's close
//     still flat              -> carry the last known polarity
//
// TradingView's own documentation on the matter: historical bars contain OHLCV
// only, which is "insufficient to calculate volume delta on them with any
// level of precision without intrabar analysis."
//
// The approximation is decent on liquid instruments and degrades on thin ones.
// A 1-minute intrabar that opens low and closes high is counted entirely as
// buying, when in reality it contained both. Finer intrabars = better estimate.
//
// INTRABAR BUDGET: TradingView caps total intrabars a script may request —
// 100K on Basic/Essential/Plus/Premium, 125K on Expert, 200K on Ultimate.
// Lower intrabar timeframe = more precision per bar but LESS chart history
// before the script runs out. That trade-off is the reason for the "Auto"
// setting below, which picks a sane intrabar TF for your chart TF.
//
// ============================================================================
// KNOWN LIMITATION — NIFTY / BANKNIFTY SPOT WILL NOT WORK
// ============================================================================
//
// This needs real volume. NIFTY and BankNifty SPOT report zero volume —
// confirmed twice in this project, via real IBKR pulls and via yfinance
// (^NSEI 5-minute bars returned volume sum = 0). On a spot index this
// indicator will correctly show nothing and say so.
//
//     Use NSE:NIFTY1! / NSE:BANKNIFTY1! (futures), not NSE:NIFTY spot.
//     Individual Indian stocks are fine. US stocks/ETFs are fine.
//
// ============================================================================

//@version=6
indicator(title='Order Flow Volume — Institutional Footprint', shorttitle='OFV', overlay=false, format=format.volume)

// ===== Inputs =====
ltfInput     = input.string('Auto', title='Intrabar Timeframe', options=['Auto', '1S', '5S', '15S', '1', '5', '15'], tooltip='Lower = more accurate delta, less history before hitting the intrabar cap. Seconds options need a plan with seconds data.')
zLen         = input.int(20, title='Volume Z-Score / ATR Length', minval=5)
volZThresh   = input.float(1.5, title='Unusual Volume Z-Score', minval=0.5, step=0.1, tooltip='Bars with volume this many standard deviations above average are flagged as unusual participation.')
narrowMult   = input.float(0.7, title='Absorption: Max Range vs ATR', minval=0.1, step=0.1, tooltip='Absorption needs a NARROW bar on HEAVY volume — lots of trading, price went nowhere. Someone large is soaking up the other side.')
deltaSkew    = input.float(0.25, title='Absorption: Min Delta Skew', minval=0.05, step=0.05, tooltip='How one-sided delta must be (as a fraction of total volume) to call it absorption.')
divLen       = input.int(20, title='Divergence Lookback', minval=5)
showCVD      = input.bool(false, title='Show Session CVD line', tooltip='OFF by default: CVD accumulates through the session, so its magnitude dwarfs per-bar delta and visually flattens the columns. Turn on when you want the running total rather than the per-bar picture.')
showMarkers  = input.bool(true, title='Show absorption / divergence markers')

// ===== Intrabar timeframe selection =====
// Balance precision against the intrabar cap based on the chart timeframe.
autoLtf() =>
    s = timeframe.in_seconds(timeframe.period)
    s <= 60    ? '1'  :
      s <= 300  ? '1'  :
      s <= 900  ? '1'  :
      s <= 3600 ? '5'  :
      s <= 14400 ? '15' : '60'

ltf = ltfInput == 'Auto' ? autoLtf() : ltfInput

// ===== Pull intrabars =====
// Must be called at global scope, never inside a conditional or function body.
[ltfOpen, ltfClose, ltfVolume] = request.security_lower_tf(syminfo.tickerid, ltf, [open, close, volume])

// ===== Classify intrabar volume into buying vs selling =====
// `var` persists lastPolarity across bars, implementing the documented
// "carry the last known polarity" fallback for perfectly flat intrabars.
//
// THIS RUNS AT GLOBAL SCOPE ON PURPOSE. Pine functions can READ globals but
// cannot ASSIGN to them — an earlier version of this file wrapped the loop in
// a classify() function that did `lastPolarity := polarity`, which is a hard
// compile error ("Cannot modify global variable in function"). Keeping the
// loop at global scope is the fix; the alternative is threading the state
// through an array, which is uglier for no gain.
var int lastPolarity = 1

float buyVolRaw  = 0.0
float sellVolRaw = 0.0
int intrabarCount = array.size(ltfVolume)

if intrabarCount > 0
    for i = 0 to intrabarCount - 1
        o = array.get(ltfOpen, i)
        c = array.get(ltfClose, i)
        v = nz(array.get(ltfVolume, i))
        int polarity = 0
        if c > o
            polarity := 1
        else if c < o
            polarity := -1
        else
            // Flat intrabar: fall back to close vs previous intrabar close.
            if i > 0
                pc = array.get(ltfClose, i - 1)
                polarity := c > pc ? 1 : c < pc ? -1 : lastPolarity
            else
                polarity := lastPolarity
        lastPolarity := polarity
        if polarity == 1
            buyVolRaw += v
        else
            sellVolRaw += v

// Fallback when intrabars are unavailable (cap exhausted, or TF too low to
// subdivide): classify the chart bar itself. Strictly worse — flagged below.
hasIntrabars = intrabarCount > 0
barPolarity  = close > open ? 1 : close < open ? -1 : 0
buyVol       = hasIntrabars ? buyVolRaw  : (barPolarity >= 0 ? nz(volume) : 0.0)
sellVol      = hasIntrabars ? sellVolRaw : (barPolarity < 0  ? nz(volume) : 0.0)

delta    = buyVol - sellVol
totalVol = buyVol + sellVol
// Skew: -1 = all selling, +1 = all buying. Normalizes delta across volume regimes.
skew     = totalVol > 0 ? delta / totalVol : 0.0

// ===== Unusual participation (volume Z-score) =====
volSma   = ta.sma(volume, zLen)
volStdev = ta.stdev(volume, zLen)
volZ     = volStdev > 0 ? (volume - volSma) / volStdev : 0.0

// ===== Absorption =====
// Heavy volume + narrow range = a large participant absorbing the other side.
// Direction is the INVERSE of the delta: if delta is strongly positive but
// price refused to rise, the buying was absorbed by a bigger seller.
barRange    = high - low
atrVal      = ta.atr(zLen)
narrowRange = atrVal > 0 and barRange < atrVal * narrowMult
heavyVolume = volZ > volZThresh
closePos    = barRange > 0 ? (close - low) / barRange : 0.5

absorbBear = showMarkers and heavyVolume and narrowRange and skew >  deltaSkew and closePos < 0.40
absorbBull = showMarkers and heavyVolume and narrowRange and skew < -deltaSkew and closePos > 0.60

// ===== Session-anchored cumulative delta =====
// Anchored to the session, not all-time: intraday traders care about today's
// net flow, and it keeps CVD in the same order of magnitude as session volume.
newSession = ta.change(time('D')) != 0
var float cvd = 0.0
cvd := newSession ? delta : nz(cvd[1]) + delta

// ===== Delta / price divergence =====
// Price makes a new extreme but cumulative flow does not confirm it.
priceHigh = close >= ta.highest(close, divLen)
priceLow  = close <= ta.lowest(close, divLen)
cvdHigh   = cvd   >= ta.highest(cvd, divLen)
cvdLow    = cvd   <= ta.lowest(cvd, divLen)

bearDiv = showMarkers and priceHigh and not cvdHigh and not newSession
bullDiv = showMarkers and priceLow  and not cvdLow  and not newSession

// ===== Plots =====
buyColor  = color.new(color.teal, heavyVolume ? 0 : 45)
sellColor = color.new(color.red,  heavyVolume ? 0 : 45)

plot(buyVol,   title='Buy Volume',  style=plot.style_columns, color=buyColor)
plot(-sellVol, title='Sell Volume', style=plot.style_columns, color=sellColor)
plot(delta,    title='Net Delta',   style=plot.style_stepline, color=color.new(color.yellow, 10), linewidth=2)
hline(0, title='Zero', color=color.new(color.gray, 50))

plot(showCVD ? cvd : na, title='Session CVD', color=color.new(color.orange, 0), linewidth=2)

// Markers sit on the zero line so they read against both sides.
plotshape(absorbBull, title='Bullish Absorption', style=shape.diamond, location=location.absolute, color=color.new(color.lime, 0), size=size.tiny, text='ABS')
plotshape(absorbBear, title='Bearish Absorption', style=shape.diamond, location=location.absolute, color=color.new(color.fuchsia, 0), size=size.tiny, text='ABS')
plotshape(bullDiv,    title='Bullish Divergence', style=shape.triangleup,   location=location.absolute, color=color.new(color.lime, 20), size=size.tiny)
plotshape(bearDiv,    title='Bearish Divergence', style=shape.triangledown, location=location.absolute, color=color.new(color.fuchsia, 20), size=size.tiny)

// ===== Data-quality warning =====
// A silent zero is indistinguishable from a genuine flat tape, so say it out loud.
var label warnLabel = na
if barstate.islast
    label.delete(warnLabel)
    string msg = na
    if nz(volume) == 0 and nz(volume[1]) == 0
        msg := 'NO VOLUME DATA on ' + syminfo.ticker + '\nSpot indices report zero volume.\nUse the futures symbol (e.g. NSE:NIFTY1!) instead.'
    else if not hasIntrabars
        msg := 'NO INTRABAR DATA at ' + ltf + '\nFalling back to bar-level classification,\nwhich is much less accurate. Try a higher\nintrabar TF or a lower chart TF.'
    if not na(msg)
        warnLabel := label.new(bar_index, 0, msg, style=label.style_label_center, color=color.new(color.red, 10), textcolor=color.white, size=size.normal)

// ===== Alerts =====
alertcondition(absorbBull, title='Bullish Absorption', message='OFV: bullish absorption — heavy selling absorbed, price held')
alertcondition(absorbBear, title='Bearish Absorption', message='OFV: bearish absorption — heavy buying absorbed, price stalled')
alertcondition(bullDiv,    title='Bullish Divergence', message='OFV: price at lows but cumulative delta not confirming')
alertcondition(bearDiv,    title='Bearish Divergence', message='OFV: price at highs but cumulative delta not confirming')
